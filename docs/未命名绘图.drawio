        <mxCell id="c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbe5f1;strokeColor=#000000;fontSize=18;fontStyle=1;" value="第一章&#xa;绪论&#xa;&#xa;传统活动轮廓模型过度依赖人工参数设定，在处理形态复杂、纹理多变的细胞图像时分割与跟踪效果有限而现有深度活动轮廓模型多聚焦于实例分割任务，尚未适配细胞形变跟踪场景" vertex="1">
          <mxGeometry height="520" width="160" x="20" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9e2f3;strokeColor=#000000;fontSize=18;fontStyle=1;" value="第二章&#xa;相关理论基础及技术&#xa;&#xa;系统阐述了深度学习、目标检测与活动轮廓模型相关理论基础，为后续研究奠定了理论支撑" vertex="1">
