        <mxCell id="topbar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#000000;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" value="基于深度活动轮廓模型的细胞跟踪算法研究" vertex="1">
